# Copy to .env. Keys stay in the local backend, never in HTML or report JSON.
PROPERTYDATA_API_KEY=
# AI uses your local Codex ChatGPT login. No API providers or fallback.
CODEX_BIN=codex
# Blank uses the model selected by your Codex installation.
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
# Existing Firecrawl MCP authentication can be reused; alternatively supply a key.
FIRECRAWL_API_KEY=
CODEX_RESEARCH_TARGET_SECONDS=300
CODEX_RESEARCH_MAX_SECONDS=600
PORT=8000

